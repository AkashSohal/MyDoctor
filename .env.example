# Supabase (public project URL + publishable key only - never a secret/service-role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side scripts only (scripts/seed.ts) - keep out of frontend code
# SUPABASE_SERVICE_ROLE_KEY=

# Maps (Choose one)
NEXT_PUBLIC_MAPS_PROVIDER=leaflet
# GOOGLE_MAPS_API_KEY=
# MAPBOX_ACCESS_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MyDoctor